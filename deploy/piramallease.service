[Unit]
Description=Piramallease Gunicorn Service
After=network.target

[Service]
User=root
Group=www-data
WorkingDirectory=/var/www/piramallease/Backend
EnvironmentFile=/var/www/piramallease/Backend/.env
ExecStart=/var/www/piramallease/venv/bin/gunicorn \
    config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 120 \
    --access-logfile /var/log/piramallease/gunicorn-access.log \
    --error-logfile /var/log/piramallease/gunicorn-error.log
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
